==id $Id: regex_lib.sfd 1.0 (06.11.2026) MIT, AmiCradle Team $
* regex.library (GFOpenRegex): POSIX regular expressions, with Perl syntax
* as an option. This file is the source of the fd, clib, inline and
* library entry files: tools/gen_headers.py makes them.
==base _RegexBase
==basetype struct Library *
==libname regex.library
==bias 30
==public
==include <libraries/regex.h>
* version 1
LONG RegComp(regex_t * preg, CONST_STRPTR pattern, LONG cflags) (a0,a1,d0)
LONG RegExec(CONST regex_t * preg, CONST_STRPTR string, ULONG nmatch, regmatch_t * pmatch, LONG eflags) (a0,a1,d0,a2,d1)
ULONG RegError(LONG errcode, CONST regex_t * preg, STRPTR errbuf, ULONG size) (d0,a0,a1,d1)
VOID RegFree(regex_t * preg) (a0)
LONG RegNComp(regex_t * preg, CONST_STRPTR pattern, ULONG length, LONG cflags) (a0,a1,d0,d1)
LONG RegNExec(CONST regex_t * preg, CONST_STRPTR string, ULONG length, ULONG nmatch, regmatch_t * pmatch, LONG eflags) (a0,a1,d0,d1,a2,d2)
==end
