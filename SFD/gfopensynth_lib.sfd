* gfopensynth.library (GFOpenSynth): MT-32 and General MIDI music. This
* file is the source of the fd, clib and inline files: tools/gen_headers.py
* makes them.
==base _GFOpenSynthBase
==basetype struct Library *
==libname gfopensynth.library
==bias 30
==public
==include <libraries/gfopensynth.h>
* version 1
struct GSSynth * GSOpenSynthA(CONST struct TagItem * tags) (a0)
VOID GSCloseSynth(struct GSSynth * synth) (a0)
VOID GSShortMsg(struct GSSynth * synth, ULONG msg) (a0,d0)
VOID GSSysEx(struct GSSynth * synth, CONST UBYTE * data, ULONG len) (a0,a1,d0)
BOOL GSPlayFileA(struct GSSynth * synth, CONST_STRPTR name, CONST struct TagItem * tags) (a0,a1,a2)
VOID GSStopFile(struct GSSynth * synth) (a0)
VOID GSSetVolume(struct GSSynth * synth, ULONG volume) (a0,d0)
VOID GSReset(struct GSSynth * synth) (a0)
ULONG GSGetAttr(struct GSSynth * synth, ULONG attr) (a0,d0)
ULONG GSRenderS16(struct GSSynth * synth, WORD * buffer, ULONG frames) (a0,a1,d0)
BOOL GSPlayMemA(struct GSSynth * synth, CONST UBYTE * data, ULONG len, CONST struct TagItem * tags) (a0,a1,d0,a2)
VOID GSPauseFile(struct GSSynth * synth, ULONG pause) (a0,d0)
VOID GSSeekFile(struct GSSynth * synth, ULONG beat) (a0,d0)
VOID GSWriteBytes(struct GSSynth * synth, CONST UBYTE * data, ULONG len) (a0,a1,d0)
ULONG GSMemLength(CONST UBYTE * data, ULONG len) (a0,d0)
