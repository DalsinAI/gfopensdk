==id $Id: bzip2_lib.sfd 1.0 (17.11.2026) MIT, AmiCradle Team $
* bzip2.library (GFOpenBZip2): bzip2 compression and decompression, upstream
* bzip2 1.0.8's libbzip2 as a shared library. The calls are libbzip2's
* stream and buffer calls; strm is a bz_stream (<bzlib.h>). This file is the
* source of the fd, clib and inline files: tools/gen_headers.py makes them.
==base _BZip2Base
==basetype struct Library *
==libname bzip2.library
==bias 30
==public
==include <libraries/bzip2.h>
* version 1
LONG BZ2CompressInit(APTR strm, LONG blockSize100k, LONG verbosity, LONG workFactor) (a0,d0,d1,d2)
LONG BZ2Compress(APTR strm, LONG action) (a0,d0)
LONG BZ2CompressEnd(APTR strm) (a0)
LONG BZ2DecompressInit(APTR strm, LONG verbosity, LONG small) (a0,d0,d1)
LONG BZ2Decompress(APTR strm) (a0)
LONG BZ2DecompressEnd(APTR strm) (a0)
LONG BZ2BuffToBuffCompress(STRPTR dest, ULONG * destLen, STRPTR source, ULONG sourceLen, LONG blockSize100k, LONG verbosity, LONG workFactor) (a0,a1,a2,d0,d1,d2,d3)
LONG BZ2BuffToBuffDecompress(STRPTR dest, ULONG * destLen, STRPTR source, ULONG sourceLen, LONG small, LONG verbosity) (a0,a1,a2,d0,d1,d2)
CONST_STRPTR BZ2LibVersion() ()
==end
