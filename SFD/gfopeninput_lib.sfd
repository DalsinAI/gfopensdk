APTR OIN_AddDriverPad(struct OIControllerInfo *info, ULONG infoSize)(a0,d0)
VOID OIN_DriverPadRaw(APTR pad, struct OIRawState *raw, ULONG rawSize)(a0,a1,d0)
VOID OIN_RemDriverPad(APTR pad)(a0)
